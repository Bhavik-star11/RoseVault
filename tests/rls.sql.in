begin;
create temp table test_results(name text,passed boolean) on commit drop;
create temp table test_state(name text primary key,value jsonb) on commit drop;
grant select,insert,update on test_results,test_state to authenticated,anon;
create function pg_temp.assert_true(label text,ok boolean) returns void language plpgsql as $$ begin if ok is not true then raise exception 'FAILED: %',label; end if; insert into test_results values(label,true); end $$;
create function pg_temp.expect_error(label text,statement text,codes text[] default array['42501','P0001']) returns void language plpgsql as $$ begin begin execute statement; exception when others then if sqlstate=any(codes) then insert into test_results values(label,true);return;else raise;end if;end;raise exception 'FAILED (unexpectedly allowed): %',label;end $$;
insert into auth.users(id,instance_id,aud,role,phone,phone_confirmed_at,raw_app_meta_data,raw_user_meta_data,created_at,updated_at) values
 ('11111111-1111-4111-8111-111111111111','00000000-0000-0000-0000-000000000000','authenticated','authenticated','12025550101',now(),'{"provider":"phone","providers":["phone"]}','{}',now(),now()),
 ('22222222-2222-4222-8222-222222222222','00000000-0000-0000-0000-000000000000','authenticated','authenticated','12025550102',now(),'{"provider":"phone","providers":["phone"]}','{}',now(),now()),
 ('33333333-3333-4333-8333-333333333333','00000000-0000-0000-0000-000000000000','authenticated','authenticated','12025550103',null,'{"provider":"phone","providers":["phone"]}','{}',now(),now());
-- TEST_KEYS substituted from generated, public-only P-256 identities.
insert into test_state values('alice_key',to_jsonb('__ALICE_KEY__'::text)),('bob_key',to_jsonb('__BOB_KEY__'::text));
set local role anon;
select pg_temp.expect_error('anonymous cannot call phone directory', $$select public.phone('profile','{}')$$);
select pg_temp.expect_error('anonymous cannot read conversations', $$select * from public.rv_conversations$$);
set local role authenticated;
select set_config('request.jwt.claims',jsonb_build_object('sub','11111111-1111-4111-8111-111111111111','role','authenticated','amr',jsonb_build_array(jsonb_build_object('method','otp','timestamp',extract(epoch from now())::bigint)))::text,true);
select public.phone('register',jsonb_build_object('key',(select value#>>'{}' from test_state where name='alice_key'),'deviceId','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','discoverable',true));
select pg_temp.assert_true('verified registration uses canonical phone',(public.phone('profile',jsonb_build_object('key',(select value#>>'{}' from test_state where name='alice_key')))->>'phoneNumber')='+12025550101');
select pg_temp.expect_error('profiles remain private', $$select * from private.phone_profiles$$);
select pg_temp.expect_error('rate counters remain private', $$select * from private.phone_limits$$);
select pg_temp.expect_error('invalid device keys are rejected', $$select public.phone('register','{"key":"invalid","deviceId":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","discoverable":true}')$$);
select pg_temp.expect_error('missing number is not discoverable', $$select public.phone('startChat',jsonb_build_object('key',(select value#>>'{}' from test_state where name='alice_key'),'phoneNumber','+12025550199'))$$);
select pg_temp.expect_error('conversation membership cannot be client-created', $$insert into public.rv_conversations(id,members,keys) values(repeat('a',64),array['11111111-1111-4111-8111-111111111111'::uuid,'22222222-2222-4222-8222-222222222222'::uuid],'{}')$$);
select set_config('request.jwt.claims',jsonb_build_object('sub','22222222-2222-4222-8222-222222222222','role','authenticated','amr',jsonb_build_array(jsonb_build_object('method','otp','timestamp',extract(epoch from now())::bigint)))::text,true);
select public.phone('register',jsonb_build_object('key',(select value#>>'{}' from test_state where name='bob_key'),'deviceId','bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','discoverable',false));
select set_config('request.jwt.claims',jsonb_build_object('sub','11111111-1111-4111-8111-111111111111','role','authenticated','amr',jsonb_build_array(jsonb_build_object('method','otp','timestamp',extract(epoch from now())::bigint)))::text,true);
select pg_temp.expect_error('opted-out number is hidden', $$select public.phone('startChat',jsonb_build_object('key',(select value#>>'{}' from test_state where name='alice_key'),'phoneNumber','+12025550102'))$$);
select set_config('request.jwt.claims',jsonb_build_object('sub','22222222-2222-4222-8222-222222222222','role','authenticated','amr',jsonb_build_array(jsonb_build_object('method','otp','timestamp',extract(epoch from now())::bigint)))::text,true);
select public.phone('discovery',jsonb_build_object('key',(select value#>>'{}' from test_state where name='bob_key'),'discoverable',true));
select pg_temp.expect_error('discovery cannot omit the pinned device key', $$select public.phone('discovery','{"discoverable":false}')$$);
select set_config('request.jwt.claims',jsonb_build_object('sub','11111111-1111-4111-8111-111111111111','role','authenticated','amr',jsonb_build_array(jsonb_build_object('method','otp','timestamp',extract(epoch from now())::bigint)))::text,true);
insert into test_state values('conversation',public.phone('startChat',jsonb_build_object('key',(select value#>>'{}' from test_state where name='alice_key'),'phoneNumber','+12025550102')));
select pg_temp.assert_true('shared phone conversation has two pinned identities',(select count(*)=1 from public.rv_conversations where cardinality(members)=2 and keys->>'11111111-1111-4111-8111-111111111111'=(select value#>>'{}' from test_state where name='alice_key')));
select pg_temp.expect_error('chat info cannot omit the pinned key', $$select public.phone('chatInfo',jsonb_build_object('id',(select value->>'id' from test_state where name='conversation')))$$);
select pg_temp.expect_error('members cannot rewrite pinned keys', $$update public.rv_conversations set keys='{}'$$);
insert into public.rv_messages(id,conversation_id,sender,envelope,created_at) values('aaaaaaaa-0000-4000-8000-000000000001',(select value->>'id' from test_state where name='conversation'),auth.uid(),'ENCv1:fixture:encrypted',extract(epoch from now())*1000);
select pg_temp.assert_true('member can save encrypted envelope',(select count(*)=1 from public.rv_messages));
select pg_temp.expect_error('plaintext cannot be stored', $$insert into public.rv_messages(id,conversation_id,sender,envelope,created_at) values('aaaaaaaa-0000-4000-8000-000000000002',(select value->>'id' from test_state where name='conversation'),auth.uid(),'plaintext',extract(epoch from now())*1000)$$,array['23514']);
select pg_temp.expect_error('sender impersonation is blocked', $$insert into public.rv_messages(id,conversation_id,sender,envelope,created_at) values('aaaaaaaa-0000-4000-8000-000000000003',(select value->>'id' from test_state where name='conversation'),'22222222-2222-4222-8222-222222222222','ENCv1:fixture:encrypted',extract(epoch from now())*1000)$$);
select pg_temp.expect_error('messages are immutable', $$update public.rv_messages set envelope='ENCv1:changed'$$);
insert into public.rv_calls(id,conversation_id,from_uid,to_uid,status,video,created_at,offer) values('aaaaaaaa-0000-4000-8000-000000000010',(select value->>'id' from test_state where name='conversation'),auth.uid(),'22222222-2222-4222-8222-222222222222','ringing',false,extract(epoch from now())*1000,'ENCv1:fixture:offer');
select pg_temp.expect_error('caller cannot answer their own call', $$update public.rv_calls set status='accepted',answer='ENCv1:fixture:answer'$$);
select pg_temp.expect_error('call cannot target non-member', $$insert into public.rv_calls(id,conversation_id,from_uid,to_uid,status,video,created_at,offer) values('aaaaaaaa-0000-4000-8000-000000000011',(select value->>'id' from test_state where name='conversation'),auth.uid(),'33333333-3333-4333-8333-333333333333','ringing',false,extract(epoch from now())*1000,'ENCv1:fixture:offer')$$);
insert into storage.objects(bucket_id,name,owner_id) values('vault-media','media/'||(select value->>'id' from test_state where name='conversation')||'/aaaaaaaa-0000-4000-8000-000000000001',auth.uid()::text);
select pg_temp.assert_true('private attachment metadata can be created by member',(select count(*)=1 from storage.objects where bucket_id='vault-media'));
select set_config('request.jwt.claims',jsonb_build_object('sub','22222222-2222-4222-8222-222222222222','role','authenticated','amr',jsonb_build_array(jsonb_build_object('method','otp','timestamp',extract(epoch from now())::bigint)))::text,true);
select pg_temp.assert_true('recipient receives encrypted message',(select count(*)=1 from public.rv_messages));
select pg_temp.assert_true('recipient can access private attachment',(select count(*)=1 from storage.objects where bucket_id='vault-media'));
update public.rv_calls set status='accepted',answer='ENCv1:fixture:answer';
select pg_temp.assert_true('recipient can accept call',(select status='accepted' from public.rv_calls limit 1));
select pg_temp.expect_error('call answer cannot be rewritten', $$update public.rv_calls set answer='ENCv1:changed'$$);
select pg_temp.expect_error('call identities cannot be changed', $$update public.rv_calls set from_uid=auth.uid()$$);
select public.phone('discovery',jsonb_build_object('key',(select value#>>'{}' from test_state where name='bob_key'),'discoverable',false));
select pg_temp.assert_true('opt-out preserves existing conversation',public.phone('chatInfo',jsonb_build_object('id',(select value->>'id' from test_state where name='conversation'),'key',(select value#>>'{}' from test_state where name='bob_key')))->>'phoneNumber'='+12025550101');
select set_config('request.jwt.claims','{"sub":"33333333-3333-4333-8333-333333333333","role":"authenticated"}',true);
select pg_temp.assert_true('outsider cannot read conversations',(select count(*)=0 from public.rv_conversations));
select pg_temp.assert_true('outsider cannot read messages',(select count(*)=0 from public.rv_messages));
select pg_temp.assert_true('outsider cannot read private files',(select count(*)=0 from storage.objects where bucket_id='vault-media'));
select pg_temp.expect_error('unverified number cannot register', $$select public.phone('register',jsonb_build_object('key',(select value#>>'{}' from test_state where name='bob_key'),'deviceId','bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','discoverable',true))$$);
select set_config('request.jwt.claims','{"sub":"11111111-1111-4111-8111-111111111111","role":"authenticated","amr":[{"method":"otp","timestamp":1}]}',true);
select pg_temp.expect_error('stale OTP cannot replace device key', $$select public.phone('register',jsonb_build_object('key',(select value#>>'{}' from test_state where name='alice_key'),'deviceId','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','discoverable',true))$$);
select jsonb_build_object('passed',count(*),'cases',jsonb_agg(name)) as test_report from test_results;
rollback;
