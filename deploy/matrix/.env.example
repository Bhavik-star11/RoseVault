# Select this name before creating accounts; changing server_name later is a migration.
MATRIX_HOST=matrix.example.org
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Pin all images to reviewed digests before production; keep patches current.
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.164.1
POSTGRES_IMAGE=postgres:17
CADDY_IMAGE=caddy:2
# Match private /data ownership to Synapse's container user. Never use UID 0.
SYNAPSE_UID=991
SYNAPSE_GID=991
