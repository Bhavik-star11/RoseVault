# EXAMPLE ONLY: replace every REPLACE_ value before starting coturn.
# Read REMOTE_CALLS_SETUP.md. Keep the real shared secret out of Git.
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49200
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_STRONG_RANDOM_PRIVATE_SECRET
realm=REPLACE_WITH_TURN_DOMAIN
# For a NATed host, use PUBLIC_IP/PRIVATE_IP and same-port forwarding.
external-ip=REPLACE_WITH_PUBLIC_IP
cert=REPLACE_WITH_SERVICE_READABLE_CERTIFICATE_PATH
pkey=REPLACE_WITH_SERVICE_READABLE_PRIVATE_KEY_PATH
stale-nonce=600
no-cli
no-multicast-peers
# Prevent the relay being used to reach local/private infrastructure.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Review additional host/provider-specific ranges before public operation.
